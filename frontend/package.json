{
  "name": "yin-panel",
  "version": "0.0.0",
  "private": false,
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@9.15.5",
  "description": "Yin-Panel Web",
  "author": "BraisedHunter <95302870@qq.com>",
  "keywords": [
    "Yin-Panel",
    "vue"
  ],
  "scripts": {
    "check:i18n": "node scripts/check-i18n-keys.mjs",
    "audit:theme-tokens": "node scripts/audit-theme-tokens.mjs",
    "test:home-services": "node --test tests/unit/*.test.mjs",
    "build:theme-sdk": "npm --prefix packages/theme-sdk run build",
    "create:theme": "node packages/create-theme/bin/yin-theme.mjs",
    "dev": "vite",
    "build": "run-p add-version type-check build-only",
    "add-version": "node ./add-frontend-version.js",
    "preview": "vite preview",
    "build-only": "vite build",
    "test:perf": "npm run build-only && playwright test",
    "test:e2e": "playwright test --config playwright.e2e.config.ts",
    "type-check": "vue-tsc --noEmit",
    "lint": "npm run audit:theme-tokens && eslint .",
    "lint:fix": "eslint . --fix",
    "bootstrap": "npm install && npm run common:prepare",
    "bootstrap:pnpm": "pnpm install && pnpm run common:prepare",
    "common:cleanup": "rimraf node_modules",
    "common:prepare": "husky install"
  },
  "dependencies": {
    "@iconify/vue": "^5.0.3",
    "@traptitech/markdown-it-katex": "^3.6.0",
    "@vueuse/core": "^15.0.0",
    "ajv": "^8.20.0",
    "axios": "^1.20.0",
    "crypto-js": "^4.2.0",
    "css-tree": "^1.1.3",
    "highlight.js": "^11.12.0",
    "katex": "^0.18.9",
    "markdown-it": "^15.0.2",
    "markdown-it-link-attributes": "^4.0.1",
    "moment": "^2.31.0",
    "naive-ui": "^2.45.3",
    "pinia": "^4.0.3",
    "vue": "^3.5.43",
    "vue-draggable-plus": "^0.6.1",
    "vue-i18n": "^11.4.12",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.5.1",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/crypto-js": "^4.2.2",
    "@types/katex": "^0.16.8",
    "@types/markdown-it": "^14.2.0",
    "@types/markdown-it-link-attributes": "^3.0.5",
    "@types/node": "^22.20.4",
    "@types/sortablejs": "^1.15.9",
    "@vitejs/plugin-vue": "^6.0.9",
    "esbuild": "^0.28.1",
    "eslint": "^10.11.0",
    "fast-glob": "^3.3.3",
    "less": "^4.9.1",
    "lint-staged": "^17.5.1",
    "npm-run-all": "^4.1.5",
    "postcss": "^8.5.28",
    "rimraf": "^6.1.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^1.3.0",
    "vite-plugin-svg-icons": "^2.0.1",
    "vue-tsc": "^3.3.11",
    "workbox-build": "^7.4.1",
    "workbox-window": "^7.4.1"
  },
  "lint-staged": {
    "*.{ts,tsx,vue}": [
      "eslint --fix"
    ]
  },
  "overrides": {
    "workbox-build": "^7.4.1",
    "workbox-window": "^7.4.1",
    "svg-baker": {
      "image-size": "^2.0.4",
      "micromatch": "^4.0.8",
      "postcss": "^8.5.28"
    },
    "braces": "^3.0.3"
  },
  "pnpm": {
    "overrides": {
      "workbox-build": "^7.4.1",
      "workbox-window": "^7.4.1",
      "svg-baker>image-size": "^2.0.4",
      "svg-baker>micromatch": "^4.0.8",
      "svg-baker>postcss": "^8.5.28",
      "braces": "^3.0.3"
    }
  }
}
