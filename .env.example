# Copy to .env.local and keep the local file untracked.
# Do not commit real credentials or machine-specific absolute paths.

YIN_PANEL_PORT=3002
YIN_PANEL_URL=http://127.0.0.1:3002

# Paths are machine-specific. Use absolute paths only in .env.local.
YIN_PANEL_RUNTIME_DIR=
YIN_PANEL_EXTENSION_DIR=
YIN_PANEL_E2E_DIR=
YIN_PANEL_ENV_FILE=

# Build-time frontend value: the Cloudflare Web Analytics site token. Deployments
# source this file before building, so the beacon is emitted into index.html when it
# is set. Leave empty to ship no third-party analytics script.
VITE_GLOB_CF_BEACON_TOKEN=

# E2E credentials. Prefer a short-lived test token when available.
YIN_PANEL_TEST_USER=
YIN_PANEL_TEST_PASSWORD=
YIN_PANEL_TEST_TOKEN=
YIN_PANEL_TEST_SPACE_ID=1

# Used only by explicit local sudo installation commands. Never commit this value.
SUDO_PASSWORD=
